{
  "name": "simpleworship",
  "private": true,
  "version": "1.0.0",
  "description": "SimpleWorship Church Presentation & Multi-Display Software",
  "author": "SimpleWorship Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "dev:electron": "electron .",
    "build": "vite build && node scripts/postbuild.cjs",
    "build:renderer": "vite build",
    "dist": "vite build && node scripts/postbuild.cjs && electron-builder --win",
    "dist:dir": "vite build && node scripts/postbuild.cjs && electron-builder --dir",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:installer": "vite build && node scripts/postbuild.cjs && electron-builder --win"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.95",
    "ai": "^7.0.92",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^26.4.2",
    "idb": "^8.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.4.7",
    "pptx-react-viewer": "^3.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.13",
    "react-resizable-panels": "^2.1.7",
    "uuid": "^10.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.simpleworship.app",
    "productName": "SimpleWorship",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "sws",
        "name": "SimpleWorship Schedule",
        "description": "SimpleWorship Presentation Schedule File",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "public/branding/logo/SimpleWorship.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SimpleWorship"
    }
  }
}